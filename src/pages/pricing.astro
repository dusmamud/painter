---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { pricingPlans, faqs } from '../data/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Pricing — Transparent Painting Prices | Painter"
  description="Transparent painting prices: room refresh from $249, whole home from $1,899, commercial custom quotes. Fixed quotes, no hidden costs, free estimates."
  extraJsonLd={[faqLd]}
>
  <PageHero
    eyebrow="Pricing"
    title="Honest Prices. No Surprises."
    description="Every project starts with a free visit and a fixed quote. The price you approve is the price you pay — no hidden costs, ever."
  />

  <section class="bg-white py-14 sm:py-16" aria-label="Pricing plans">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-3 lg:items-stretch">
        {pricingPlans.map((plan, i) => (
          <article
            class={`reveal relative flex flex-col rounded-3xl p-7 sm:p-8 ${plan.featured ? 'bg-navy text-white shadow-[0_25px_50px_-20px_rgba(12,21,38,0.5)] lg:-my-3 lg:py-11' : 'bg-white ring-1 ring-line'}`}
            data-delay={String(i * 0.1)}
          >
            {plan.featured && (
              <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-sun px-4 py-1.5 text-xs font-bold text-navy">Most Popular</span>
            )}
            <h2 class={`text-lg font-bold ${plan.featured ? 'text-white' : 'text-ink'}`}>{plan.name}</h2>
            <p class={`mt-4 flex items-baseline gap-2 ${plan.featured ? 'text-white' : 'text-ink'}`}>
              <span class="text-4xl font-extrabold tracking-tight sm:text-[2.75rem]">{plan.price}</span>
              <span class={`text-sm font-medium ${plan.featured ? 'text-white/70' : 'text-muted'}`}>{plan.unit}</span>
            </p>
            <p class={`mt-3 text-sm leading-relaxed ${plan.featured ? 'text-white/70' : 'text-muted'}`}>{plan.blurb}</p>
            <ul class="mt-6 flex-1 space-y-3">
              {plan.features.map((f) => (
                <li class="flex items-start gap-2.5 text-[15px] font-medium">
                  <span class={`mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full ${plan.featured ? 'bg-sun text-navy' : 'bg-sun-soft text-navy'}`}>
                    <Icon name="check" class="h-3 w-3" />
                  </span>
                  {f}
                </li>
              ))}
            </ul>
            <a
              href="/contact/"
              class={`mt-8 inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition ${plan.featured ? 'bg-sun text-navy hover:bg-sun-deep' : 'bg-navy text-white hover:bg-navy-2'}`}
            >
              Get a Free Quote
              <Icon name="arrow" class="h-4 w-4" />
            </a>
          </article>
        ))}
      </div>
      <p class="reveal mx-auto mt-10 max-w-2xl text-center text-sm leading-relaxed text-muted">
        Prices are starting points for standard rooms and conditions. Your free quote reflects your exact space, paint
        choice and prep needs — and it is fixed before we start. Commercial projects are quoted individually.
      </p>
    </div>
  </section>

  <section class="bg-cream py-14 sm:py-16" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mx-auto text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-600">FAQ</p>
        <h2 id="faq-heading" class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">Questions, Answered</h2>
      </div>
      <div class="reveal mt-8">
        <Faq faqs={faqs} />
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
