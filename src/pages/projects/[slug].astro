---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Picture from '../../components/Picture.astro';
import Icon from '../../components/Icon.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { site, projects } from '../../data/site';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const others = projects.filter((p) => p.slug !== project.slug).slice(0, 3);

const workLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.blurb,
  creator: { '@type': 'HousePainter', '@id': `${site.url}/#business`, name: site.name, url: `${site.url}/` },
  contentLocation: project.location,
  url: `${site.url}/projects/${project.slug}/`,
};
---

<Layout
  title={`${project.title} — ${project.category} Painting in ${project.location} | Painter`}
  description={project.blurb}
  ogImage={project.image}
  extraJsonLd={[workLd]}
>
  <PageHero eyebrow="Case Study" title={project.title} description={project.blurb} />

  <section class="bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal flex flex-wrap gap-2.5" aria-label="Project facts">
        <span class="rounded-full bg-sun-soft px-4 py-2 text-sm font-semibold text-navy">{project.category}</span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-cream px-4 py-2 text-sm font-medium text-ink ring-1 ring-line"><Icon name="pin" class="h-4 w-4 text-sun-deep" />{project.location}</span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-cream px-4 py-2 text-sm font-medium text-ink ring-1 ring-line"><Icon name="clock" class="h-4 w-4 text-sun-deep" />{project.duration}</span>
      </div>

      <div class="mt-8 grid items-start gap-8 lg:grid-cols-2 lg:gap-12">
        <div class="reveal">
          <BeforeAfter image={project.image} alt={project.title} sizes="(max-width: 1023px) 92vw, 46vw" />
          <p class="mt-3 text-center text-xs text-muted">Drag the slider to compare the before &amp; after. Preview treatment applied for illustration.</p>
        </div>
        <div class="reveal" data-delay="0.1">
          <h2 class="text-xl font-bold text-ink">The challenge</h2>
          <p class="mt-2.5 text-[15px] leading-relaxed text-muted">{project.challenge}</p>
          <h2 class="mt-7 text-xl font-bold text-ink">What we did</h2>
          <p class="mt-2.5 text-[15px] leading-relaxed text-muted">{project.solution}</p>
          <h2 class="mt-7 text-xl font-bold text-ink">The result</h2>
          <p class="mt-2.5 text-[15px] leading-relaxed text-muted">{project.result}</p>

          <h3 class="mt-8 text-sm font-semibold uppercase tracking-[0.14em] text-muted">Palette used</h3>
          <div class="mt-3 flex flex-wrap gap-2.5">
            {project.palette.map((c) => (
              <span class="inline-flex items-center gap-2 rounded-full bg-cream py-1.5 pl-1.5 pr-3.5 text-sm font-medium text-ink ring-1 ring-line">
                <span class="h-6 w-6 rounded-full ring-1 ring-line" style={`background-color: ${c.hex};`} aria-hidden="true"></span>
                {c.name}
              </span>
            ))}
          </div>

          <h3 class="mt-8 text-sm font-semibold uppercase tracking-[0.14em] text-muted">Scope of work</h3>
          <ul class="mt-3 grid gap-2.5 sm:grid-cols-2">
            {project.scope.map((item) => (
              <li class="flex items-start gap-2.5 text-[15px] font-medium text-ink">
                <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-sun text-navy">
                  <Icon name="check" class="h-3 w-3" />
                </span>
                {item}
              </li>
            ))}
          </ul>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/quote/" class="inline-flex items-center gap-2 rounded-full bg-sun px-6 py-3 text-sm font-semibold text-navy transition hover:bg-sun-deep">
              Get a Similar Quote
              <Icon name="arrow" class="h-4 w-4" />
            </a>
            <a href="/colors/" class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 text-sm font-semibold text-ink transition hover:border-ink">
              Try These Colors
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream py-14 sm:py-16" aria-labelledby="others-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="others-heading" class="reveal text-2xl font-bold tracking-tight text-ink sm:text-3xl">More Projects</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((p) => (
          <article class="reveal group overflow-hidden rounded-3xl bg-white ring-1 ring-line transition-shadow duration-300 hover:shadow-[0_20px_45px_-18px_rgba(12,21,38,0.3)]">
            <a href={`/projects/${p.slug}/`} class="block h-44 overflow-hidden" tabindex="-1" aria-hidden="true">
              <Picture
                src={p.image}
                alt=""
                sizes="(max-width: 639px) 92vw, (max-width: 1023px) 46vw, 380px"
                widths={[480, 800, 1200]}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                pictureClass="block h-full w-full"
              />
            </a>
            <div class="px-6 pb-6 pt-5">
              <h3 class="text-lg font-bold text-ink">
                <a href={`/projects/${p.slug}/`} class="transition-colors hover:text-amber-600">{p.title}</a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{p.blurb}</p>
              <a href={`/projects/${p.slug}/`} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-ink transition-colors hover:text-amber-600">
                View Case Study
                <Icon name="arrow" class="h-4 w-4" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
