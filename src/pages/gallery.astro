---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Picture from '../components/Picture.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { projects } from '../data/site';

const filters = ['All', 'Interior', 'Exterior', 'Commercial', 'Cabinet'];

const extras = [
  {
    title: 'Factory-Smooth Cabinet Respray',
    category: 'Cabinet',
    location: 'Oakdale, CA',
    image: '/images/service-cabinet.jpg',
    href: '/services/cabinet-painting/',
    note: 'Kitchen cabinets, sprayed in place — no removal, no dust in the house.',
  },
  {
    title: 'Color Consultation in Action',
    category: 'Interior',
    location: 'Paintville, CA',
    image: '/images/service-consultation.jpg',
    href: '/services/color-consultation/',
    note: 'Anna testing large swatches on a client wall before a single drop is bought.',
  },
  {
    title: 'Sunny Living Room, Finished',
    category: 'Interior',
    location: 'Paintville, CA',
    image: '/images/hero-living-room.jpg',
    href: '/projects/sunny-family-living-room/',
    note: 'Warm mustard, crisp white trim — the brightest room in the house now.',
  },
  {
    title: 'Two Coats, Zero Mess',
    category: 'Interior',
    location: 'Paintville, CA',
    image: '/images/about-action.jpg',
    href: '/process/',
    note: 'Drop cloths down, edges taped, music on — the crew mid-job.',
  },
];

const items = [
  ...projects.map((p) => ({
    title: p.title,
    category: p.category,
    location: p.location,
    image: p.image,
    href: `/projects/${p.slug}/`,
    note: p.blurb,
  })),
  ...extras,
];
---

<Layout
  title="Gallery — Recent Painting Work, Before & After | Painter"
  description="Browse recent painting work by Painter — interiors, exteriors, commercial spaces and cabinets, with notes on what each job involved."
>
  <PageHero
    eyebrow="Gallery"
    title="Proof, Not Promises"
    description="Every photo below is a real job we finished — filter by room or building type and see what your space could look like."
  />

  <section class="bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal flex flex-wrap gap-2" role="group" aria-label="Filter gallery by job type">
        {filters.map((f) => (
          <button
            type="button"
            data-filter-btn={f}
            aria-pressed={f === 'All' ? 'true' : 'false'}
            class={`rounded-full border border-line px-4 py-3 text-sm font-medium transition hover:border-ink hover:text-ink ${f === 'All' ? 'bg-navy text-white' : 'bg-white text-muted'}`}
          >
            {f}
          </button>
        ))}
      </div>

      <div class="mt-8 grid auto-rows-[260px] gap-4 sm:auto-rows-[280px] sm:grid-cols-2 lg:grid-cols-3">
        {items.map((item, i) => (
          <a
            href={item.href}
            data-category={item.category}
            class={`reveal group relative block overflow-hidden rounded-3xl ring-1 ring-line ${i === 0 ? 'sm:col-span-2 sm:row-span-2' : ''}`}
            data-delay={String((i % 3) * 0.1)}
          >
            <Picture
              src={item.image}
              alt={item.title}
              sizes="(max-width: 767px) 92vw, (max-width: 1023px) 46vw, 31vw"
              widths={[480, 800, 1200]}
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <span class="absolute inset-0 bg-gradient-to-t from-navy/85 via-navy/20 to-transparent" aria-hidden="true"></span>
            <span class="absolute inset-x-0 bottom-0 p-5">
              <span class="inline-block rounded-full bg-sun px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-navy">{item.category}</span>
              <span class="mt-2 block text-lg font-bold leading-snug text-white">{item.title}</span>
              <span class="mt-1 block text-sm text-white/80">{item.location} — {item.note}</span>
            </span>
          </a>
        ))}
      </div>

      <p class="reveal mt-8 text-center text-sm text-muted">
        Want your home in this gallery? <a href="/quote/" class="font-semibold text-ink underline decoration-sun decoration-2 underline-offset-4 hover:text-amber-600">Get a free quote</a> and we will bring the same finish to your walls.
      </p>
    </div>
  </section>

  <ContactCTA />
</Layout>
