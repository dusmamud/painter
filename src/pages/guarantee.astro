---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { guarantees } from '../data/site';

const rows = [
  { label: 'Written fixed quote', us: true, typical: 'Often verbal', diy: '—' },
  { label: '5-year workmanship warranty', us: true, typical: '1 year, if any', diy: 'None' },
  { label: 'Full prep: wash, fill, sand, prime', us: true, typical: 'Sometimes', diy: 'Rarely' },
  { label: 'Premium low-odour paints', us: true, typical: 'Builder-grade', diy: 'Whatever is cheapest' },
  { label: 'Furniture & floor protection', us: true, typical: 'You move it', diy: 'You move it' },
  { label: 'Final walkthrough together', us: true, typical: 'Rarely offered', diy: '—' },
  { label: 'Color Love Guarantee (30 days)', us: true, typical: 'No', diy: 'No' },
];
---

<Layout
  title="Our Guarantee — 5-Year Warranty, Fixed Quotes, On-Time | Painter"
  description="Every Painter project includes a 5-year workmanship warranty, fixed written quotes, on-time arrival and a 30-day Color Love Guarantee. In writing, every time."
>
  <PageHero
    eyebrow="Our Guarantee"
    title="Promises in Writing, Not Just Words"
    description="Anyone can say 'quality guaranteed.' We put every promise below in your written quote — so you can hold us to it."
  />

  <section class="bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {guarantees.map((g, i) => (
          <article class="reveal rounded-3xl bg-white p-6 ring-1 ring-line transition-shadow duration-300 hover:shadow-[0_20px_45px_-18px_rgba(12,21,38,0.3)]" data-delay={String((i % 3) * 0.1)}>
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-sun text-navy">
              <Icon name={g.icon as 'shield' | 'check' | 'clock' | 'heart' | 'sparkles' | 'users'} class="h-6 w-6" />
            </span>
            <h2 class="mt-4 text-lg font-bold text-ink">{g.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{g.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-cream py-14 sm:py-16" aria-labelledby="compare-heading">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mx-auto max-w-xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-600">Honest Comparison</p>
        <h2 id="compare-heading" class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">Painter vs. The Alternatives</h2>
      </div>
      <div class="reveal mt-8 overflow-x-auto rounded-3xl bg-white ring-1 ring-line">
        <table class="w-full min-w-[560px] text-left text-sm">
          <thead>
            <tr class="border-b border-line text-ink">
              <th scope="col" class="px-5 py-4 font-semibold">What you get</th>
              <th scope="col" class="bg-sun-soft px-5 py-4 font-bold text-navy">Painter</th>
              <th scope="col" class="px-5 py-4 font-semibold text-muted">Typical painter</th>
              <th scope="col" class="px-5 py-4 font-semibold text-muted">DIY weekend</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class="border-b border-line last:border-0">
                <th scope="row" class="px-5 py-3.5 font-medium text-ink">{r.label}</th>
                <td class="bg-sun-soft/50 px-5 py-3.5">
                  {r.us ? (
                    <span class="inline-flex items-center gap-1.5 font-semibold text-navy"><Icon name="check" class="h-4 w-4" /> Included</span>
                  ) : (
                    r.us
                  )}
                </td>
                <td class="px-5 py-3.5 text-muted">{r.typical}</td>
                <td class="px-5 py-3.5 text-muted">{r.diy}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="reveal mt-5 text-center text-sm text-muted">
        Warranty details live in your written quote. Questions? <a href="/faq/" class="font-semibold text-ink underline decoration-sun decoration-2 underline-offset-4 hover:text-amber-600">Read the FAQ</a> or <a href="/contact/" class="font-semibold text-ink underline decoration-sun decoration-2 underline-offset-4 hover:text-amber-600">ask us directly</a>.
      </p>
    </div>
  </section>

  <ContactCTA title="A Guarantee You Can Hold Us To" text="Get a free quote — every promise on this page comes with it, in writing." />
</Layout>
