---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { team, whyChooseUs } from '../data/site';
---

<Layout
  title="Our Team — Meet the Painters Behind Painter | Painter"
  description="Meet the Painter crew — Mike, Anna and Leo. Small team, big standards: neat, on time, and a little obsessed with perfect edges."
>
  <PageHero
    eyebrow="Our Team"
    title="The People Behind the Paint"
    description="No strangers in your home — just the same small crew, job after job. Here is who shows up at your door."
  />

  <section class="bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-3">
        {team.map((m, i) => (
          <article class="reveal rounded-3xl bg-cream p-7 text-center ring-1 ring-line" data-delay={String(i * 0.1)}>
            <Picture
              src={m.avatar}
              alt={`Portrait of ${m.name}`}
              sizes="128px"
              widths={[96, 160]}
              class="mx-auto h-28 w-28 rounded-full object-cover ring-4 ring-white"
            />
            <h2 class="mt-5 text-xl font-bold text-ink">{m.name}</h2>
            <p class="mt-0.5 text-sm font-semibold text-amber-600">{m.role}</p>
            <p class="mt-2 inline-block rounded-full bg-white px-3 py-1 text-xs font-semibold text-muted ring-1 ring-line">{m.years}</p>
            <p class="mt-4 text-[15px] leading-relaxed text-muted">{m.bio}</p>
            <p class="mt-4 flex items-start gap-2 rounded-2xl bg-white p-4 text-left text-sm leading-relaxed text-ink ring-1 ring-line">
              <Icon name="quote" class="mt-0.5 h-4 w-4 shrink-0 text-sun-deep" />
              {m.fact}
            </p>
          </article>
        ))}
      </div>

      <div class="reveal mx-auto mt-14 max-w-3xl">
        <h2 class="text-center text-2xl font-bold tracking-tight text-ink sm:text-3xl">Why Painters Stay — and Why That Matters to You</h2>
        <p class="mt-3 text-center text-base leading-relaxed text-muted">
          A crew that stays together paints better together. Most of our painters have been with us for years, so the person
          who quotes your job is the person who finishes it — and remembers how you like your coffee.
        </p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {whyChooseUs.map((item) => (
            <li class="flex items-center gap-2.5 rounded-2xl bg-white p-4 text-[15px] font-medium text-ink ring-1 ring-line">
              <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-sun text-navy">
                <Icon name="check" class="h-3.5 w-3.5" />
              </span>
              {item}
            </li>
          ))}
        </ul>
        <p class="mt-8 text-center">
          <a href="/careers/" class="inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3 text-sm font-semibold text-white transition hover:bg-navy-2">
            Join the crew
            <Icon name="arrow" class="h-4 w-4" />
          </a>
        </p>
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
