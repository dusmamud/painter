---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { site, jobs } from '../data/site';

const perks = [
  { icon: 'wallet', title: 'Pay that respects the craft', text: 'Above-market hourly rates, paid overtime and a bonus for on-time, 5-star jobs.' },
  { icon: 'calendar', title: 'Steady, year-round work', text: 'Interiors in winter, exteriors in summer — no feast-and-famine seasons.' },
  { icon: 'shield', title: 'Fully insured crews', text: 'Liability and workers’ compensation on every job. You are covered, always.' },
  { icon: 'sparkles', title: 'Top-grade tools provided', text: 'Sprayers, ladders, premium paints — you bring the skill, we bring the kit.' },
];

const jobsLd = jobs.map((job) => ({
  '@type': 'JobPosting',
  title: job.title,
  description: `${job.blurb} ${job.points.join(' ')}`,
  employmentType: 'FULL_TIME',
  hiringOrganization: { '@type': 'HousePainter', name: site.name, sameAs: site.url },
  jobLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: 'Paintville', addressRegion: 'CA', addressCountry: 'US' } },
  baseSalary: { '@type': 'MonetaryAmount', currency: 'USD', value: { '@type': 'QuantitativeValue', unitText: 'HOUR', value: job.pay } },
}));
---

<Layout
  title="Careers — Join the Painter Crew | Painter"
  description="Painter is hiring painters, apprentices and crew leads in Paintville, CA. Good pay, steady year-round work, top-grade tools provided."
  extraJsonLd={jobsLd}
>
  <PageHero
    eyebrow="Careers"
    title="Paint With a Crew That Stays"
    description="Most of our painters have been with us for years. If you take pride in a straight cut-in and a clean job site, we would like to meet you."
  />

  <section class="bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {perks.map((perk, i) => (
          <div class="reveal rounded-3xl bg-cream p-6 ring-1 ring-line" data-delay={String(i * 0.1)}>
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-sun text-navy">
              <Icon name={perk.icon as 'wallet' | 'calendar' | 'shield' | 'sparkles'} class="h-5 w-5" />
            </span>
            <h2 class="mt-4 text-base font-bold text-ink">{perk.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{perk.text}</p>
          </div>
        ))}
      </div>

      <h2 class="reveal mt-14 text-2xl font-bold tracking-tight text-ink sm:text-3xl">Open Roles</h2>
      <div class="mt-6 grid gap-6 lg:grid-cols-3">
        {jobs.map((job, i) => (
          <article class="reveal flex flex-col rounded-3xl bg-white p-6 ring-1 ring-line" data-delay={String(i * 0.1)}>
            <h3 class="text-lg font-bold text-ink">{job.title}</h3>
            <p class="mt-3 flex flex-wrap gap-2">
              <span class="rounded-full bg-cream px-3 py-1 text-xs font-semibold text-muted ring-1 ring-line">{job.type}</span>
              <span class="rounded-full bg-cream px-3 py-1 text-xs font-semibold text-muted ring-1 ring-line">{job.location}</span>
              <span class="rounded-full bg-sun-soft px-3 py-1 text-xs font-bold text-navy ring-1 ring-line">{job.pay}</span>
            </p>
            <p class="mt-4 text-[15px] leading-relaxed text-muted">{job.blurb}</p>
            <ul class="mt-4 space-y-2">
              {job.points.map((point) => (
                <li class="flex items-start gap-2 text-sm text-ink">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-sun-deep" />
                  {point}
                </li>
              ))}
            </ul>
            <a
              href={`mailto:${'hello@painter.com'}?subject=${encodeURIComponent(`Application: ${job.title}`)}`}
              class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-sun px-5 py-3 text-sm font-semibold text-navy transition hover:bg-sun-deep"
            >
              Apply for this role
              <Icon name="arrow" class="h-4 w-4" />
            </a>
          </article>
        ))}
      </div>

      <p class="reveal mt-8 text-center text-sm text-muted">
        Don&apos;t see your role? Email <a href="mailto:hello@painter.com" class="font-semibold text-ink underline decoration-sun decoration-2 underline-offset-4 hover:text-amber-600">hello@painter.com</a> with a line about your experience — good painters are always worth a conversation.
      </p>
    </div>
  </section>

  <ContactCTA />
</Layout>
