---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Picture from '../../components/Picture.astro';
import Icon from '../../components/Icon.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Faq from '../../components/Faq.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import { site, contact, areas, services, projects, testimonials } from '../../data/site';

export function getStaticPaths() {
  return areas.map((a) => ({ params: { town: a.slug }, props: { area: a } }));
}

const { area } = Astro.props;
const townLabel = `${area.town}, CA`;
const localProjects = projects.filter((p) => p.location.startsWith(area.town));
const nearbyProjects = localProjects.length > 0 ? localProjects : projects.slice(0, 2);
const localVoice = testimonials.find((t) => t.role.includes(area.town)) ?? testimonials[0];
const townFaqs = [
  {
    q: `Do you charge extra to come to ${area.town}?`,
    a: `No — quotes are free everywhere we work, including ${area.town}. ${area.distance === 'Home base' ? 'We are based here, so same-week visits are the norm.' : `We are ${area.distance} away and run crews here every week.`}`,
  },
  {
    q: `How fast can you start a job in ${area.town}?`,
    a: 'Most projects start within 1–2 weeks of the quote. Small rooms can often be scheduled the same week — call and we will tell you the next open slot.',
  },
];

const townLd = {
  '@context': 'https://schema.org',
  '@type': 'HousePainter',
  '@id': `${site.url}/#business`,
  name: site.name,
  url: `${site.url}/`,
  telephone: contact.phoneDisplay,
  areaServed: { '@type': 'City', name: townLabel },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: townFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title={`Painters in ${townLabel} — ${area.jobs}+ Jobs Done | Painter`}
  description={`Painter serves ${townLabel} (${area.distance} from our Paintville base): interior & exterior painting, cabinets, color consultation. ${area.jobs}+ jobs done. Free quotes.`}
  extraJsonLd={[townLd, faqLd]}
>
  <PageHero
    eyebrow="Service Areas"
    title={`Painters in ${area.town}`}
    description={`${area.note} ${area.jobs}+ jobs completed in ${area.town} — free quotes, fixed prices, and a 5-year workmanship warranty on every job.`}
  />

  <section class="bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal grid gap-4 sm:grid-cols-3">
        <div class="rounded-3xl bg-cream p-6 ring-1 ring-line">
          <span class="grid h-11 w-11 place-items-center rounded-2xl bg-sun-soft text-sun-deep"><Icon name="trophy" class="h-5 w-5" /></span>
          <p class="mt-3 text-2xl font-bold text-ink">{area.jobs}+</p>
          <p class="text-sm text-muted">jobs completed in {area.town}</p>
        </div>
        <div class="rounded-3xl bg-cream p-6 ring-1 ring-line">
          <span class="grid h-11 w-11 place-items-center rounded-2xl bg-sun-soft text-sun-deep"><Icon name="pin" class="h-5 w-5" /></span>
          <p class="mt-3 text-2xl font-bold text-ink">{area.distance}</p>
          <p class="text-sm text-muted">from our Paintville base</p>
        </div>
        <div class="rounded-3xl bg-cream p-6 ring-1 ring-line">
          <span class="grid h-11 w-11 place-items-center rounded-2xl bg-sun-soft text-sun-deep"><Icon name="star" class="h-5 w-5" /></span>
          <p class="mt-3 text-2xl font-bold text-ink">4.9 / 5</p>
          <p class="text-sm text-muted">from 380+ verified reviews</p>
        </div>
      </div>

      <div class="mt-12">
        <h2 class="reveal text-2xl font-bold tracking-tight text-ink sm:text-3xl">Services in {area.town}</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {services.slice(0, 5).map((s) => (
            <a href={`/services/${s.slug}/`} class="reveal group flex items-center gap-4 rounded-3xl bg-white p-5 ring-1 ring-line transition-shadow duration-300 hover:shadow-[0_20px_45px_-18px_rgba(12,21,38,0.3)]">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-sun-soft text-sun-deep">
                <Icon name={s.icon as 'roller' | 'home' | 'building' | 'brush' | 'palette'} class="h-6 w-6" />
              </span>
              <span>
                <span class="block font-semibold text-ink transition-colors group-hover:text-amber-600">{s.title}</span>
                <span class="mt-0.5 block text-sm text-muted">{s.priceFrom}</span>
              </span>
            </a>
          ))}
          <a href="/quote/" class="reveal group flex items-center gap-4 rounded-3xl bg-navy p-5 ring-1 ring-navy transition-shadow duration-300 hover:shadow-[0_20px_45px_-18px_rgba(12,21,38,0.3)]">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-white/10 text-sun">
              <Icon name="calculator" class="h-6 w-6" />
            </span>
            <span>
              <span class="block font-semibold text-white">Instant estimate</span>
              <span class="mt-0.5 block text-sm text-white/70">Your price in 60 seconds</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream py-14 sm:py-16" aria-labelledby="work-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="work-heading" class="reveal text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        {localProjects.length > 0 ? `Recent work in ${area.town}` : `Recent work near ${area.town}`}
      </h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {nearbyProjects.map((p) => (
          <article class="reveal group overflow-hidden rounded-3xl bg-white ring-1 ring-line transition-shadow duration-300 hover:shadow-[0_20px_45px_-18px_rgba(12,21,38,0.3)]">
            <a href={`/projects/${p.slug}/`} class="relative block h-52 overflow-hidden sm:h-56" tabindex="-1" aria-hidden="true">
              <Picture
                src={p.image}
                alt=""
                sizes="(max-width: 639px) 92vw, 46vw"
                widths={[480, 800, 1200]}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                pictureClass="block h-full w-full"
              />
              <span class="absolute left-4 top-4 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-navy">{p.category}</span>
            </a>
            <div class="px-6 pb-6 pt-5">
              <h3 class="text-lg font-bold text-ink">
                <a href={`/projects/${p.slug}/`} class="transition-colors hover:text-amber-600">{p.title}</a>
              </h3>
              <p class="mt-1 flex items-center gap-1.5 text-xs font-medium text-muted">
                <Icon name="pin" class="h-3.5 w-3.5" />
                {p.location}
              </p>
              <p class="mt-2.5 text-sm leading-relaxed text-muted">{p.blurb}</p>
              <a href={`/projects/${p.slug}/`} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-ink transition-colors hover:text-amber-600">
                View Case Study
                <Icon name="arrow" class="h-4 w-4" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-16" aria-labelledby="voice-heading">
    <div class="mx-auto grid max-w-7xl items-start gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-12 lg:px-8">
      <div class="reveal">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-600">A Local Voice</p>
        <h2 id="voice-heading" class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl">Neighbors who hired us</h2>
        <div class="mt-6">
          <TestimonialCard name={localVoice.name} role={localVoice.role} avatar={localVoice.avatar} initials={localVoice.initials} quote={localVoice.quote} />
        </div>
      </div>
      <div class="reveal" data-delay="0.1">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-600">Good To Know</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl">Questions from {area.town}</h2>
        <div class="mt-6">
          <Faq faqs={townFaqs} idPrefix={`town-${area.slug}`} />
        </div>
      </div>
    </div>
  </section>

  <ContactCTA
    title={`Ready to paint in ${area.town}?`}
    text="Get a free quote today — we reply within one business day."
  />
</Layout>
