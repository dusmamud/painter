---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { contact, faqs } from '../data/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
  title="Frequently Asked Questions — Cost, Timing, Warranty & More | Painter"
  description="Answers to the questions every homeowner asks before painting: cost, timing, prep, paint safety, warranty, areas served and payment plans."
  extraJsonLd={[faqLd]}
>
  <PageHero
    eyebrow="FAQ"
    title="Questions? Answered Honestly."
    description="Everything homeowners ask before the first coat — cost, timing, prep, safety and warranties. Anything else, just call us."
  />

  <section class="bg-white py-14 sm:py-16">
    <div class="mx-auto grid max-w-7xl items-start gap-10 px-4 sm:px-6 lg:grid-cols-5 lg:gap-12 lg:px-8">
      <div class="reveal lg:col-span-3">
        <Faq faqs={faqs} />
      </div>
      <aside class="reveal space-y-4 lg:col-span-2" data-delay="0.1">
        <div class="rounded-3xl bg-navy p-6 text-white">
          <h2 class="flex items-center gap-2 text-lg font-bold"><Icon name="chat" class="h-5 w-5 text-sun" /> Still curious?</h2>
          <p class="mt-2 text-sm leading-relaxed text-white/70">
            Call us and ask a real painter — no scripts, no pressure. If we don&apos;t know, we&apos;ll find out and call you back.
          </p>
          <a href={contact.phoneHref} class="mt-5 inline-flex items-center gap-2 rounded-full bg-sun px-5 py-2.5 text-sm font-semibold text-navy transition hover:bg-sun-deep">
            <Icon name="phone" class="h-4 w-4" />
            {contact.phoneDisplay}
          </a>
          <p class="mt-3 text-xs text-white/50">{contact.hours}</p>
        </div>
        <div class="rounded-3xl bg-cream p-6 ring-1 ring-line">
          <h2 class="text-lg font-bold text-ink">Popular next steps</h2>
          <ul class="mt-3 space-y-2.5 text-sm">
            <li><a href="/quote/" class="inline-flex items-center gap-2 font-medium text-ink transition-colors hover:text-amber-600"><Icon name="calculator" class="h-4 w-4 text-sun-deep" /> Get an instant estimate</a></li>
            <li><a href="/book/" class="inline-flex items-center gap-2 font-medium text-ink transition-colors hover:text-amber-600"><Icon name="calendar" class="h-4 w-4 text-sun-deep" /> Book a free consultation</a></li>
            <li><a href="/colors/" class="inline-flex items-center gap-2 font-medium text-ink transition-colors hover:text-amber-600"><Icon name="palette" class="h-4 w-4 text-sun-deep" /> Try the color visualizer</a></li>
            <li><a href="/guarantee/" class="inline-flex items-center gap-2 font-medium text-ink transition-colors hover:text-amber-600"><Icon name="shield" class="h-4 w-4 text-sun-deep" /> Read our guarantee</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <ContactCTA />
</Layout>
