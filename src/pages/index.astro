---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import { site, contact, services, features, stats, whyChooseUs, testimonials } from '../data/site';

const homeServices = services.slice(0, 3);
const chipColors = ['bg-sun text-navy', 'bg-[#3d7bfa] text-white', 'bg-[#7c5cf0] text-white'];
const featureChipColors = ['bg-sun-soft text-[#b8860b]', 'bg-[#e8f1fe] text-[#2f6fed]', 'bg-[#e7f7ec] text-[#1e8a4c]', 'bg-[#f1eafd] text-[#7c5cf0]'];

const housePainterLd = {
  '@context': 'https://schema.org',
  '@type': 'HousePainter',
  '@id': `${site.url}/#business`,
  name: site.name,
  url: `${site.url}/`,
  description: site.description,
  telephone: contact.phoneDisplay,
  email: contact.email,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '123 Color Street',
    addressLocality: 'Paintville',
    addressRegion: 'CA',
    postalCode: '12345',
    addressCountry: 'US',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '08:00',
    closes: '18:00',
  },
  areaServed: 'Paintville, CA',
};
---

<Layout
  title="Painter — We Paint Spaces. You Live Better."
  description="Professional painting services: interior, exterior & commercial painting with quality finishes, vibrant colors and flawless results. Trusted by 500+ happy clients. Get a free quote today."
  extraJsonLd={[housePainterLd]}
>
  <!-- Hero -->
  <section class="overflow-hidden bg-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 pb-12 pt-10 sm:px-6 lg:grid-cols-2 lg:items-center lg:gap-6 lg:px-8 lg:pb-16 lg:pt-14">
      <div class="reveal">
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-amber-600">
          <span class="h-[2px] w-7 bg-sun" aria-hidden="true"></span>
          Professional Painting Services
        </p>
        <h1 class="mt-4 text-[2.65rem] font-extrabold leading-[1.05] tracking-tight text-ink sm:text-6xl lg:text-[4.15rem]">
          We Paint Spaces.<br />
          You Live <span class="swoosh font-script font-bold text-sun-deep">Better.</span>
        </h1>
        <p class="mt-5 max-w-md text-base leading-relaxed text-muted sm:text-lg">
          Quality finishes, vibrant colors, and flawless results that bring your space to life.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="/services/" class="inline-flex items-center gap-2 rounded-full bg-sun px-6 py-3 text-sm font-semibold text-navy transition hover:bg-sun-deep">
            Explore Services
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a href="/about/#process" class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-6 py-3 text-sm font-semibold text-ink transition hover:border-ink">
            <Icon name="play" class="h-5 w-5 text-sun-deep" />
            How It Works
          </a>
        </div>
        <div class="mt-9 flex items-center gap-4">
          <div class="flex -space-x-3">
            {testimonials.slice(0, 4).map((t) => (
              <Picture src={t.avatar} alt="" sizes="40px" widths={[96, 160]} class="h-10 w-10 rounded-full object-cover ring-2 ring-white" />
            ))}
          </div>
          <div>
            <p class="text-sm font-medium text-ink">Trusted by 500+ happy clients</p>
            <p class="mt-0.5 flex items-center gap-1.5">
              <span class="text-sm font-bold text-ink">4.9</span>
              <span class="flex text-sun" role="img" aria-label="Rated 4.9 out of 5 stars">
                <Icon name="star" class="h-4 w-4" />
                <Icon name="star" class="h-4 w-4" />
                <Icon name="star" class="h-4 w-4" />
                <Icon name="star" class="h-4 w-4" />
                <Icon name="star" class="h-4 w-4" />
              </span>
            </p>
          </div>
        </div>
      </div>

      <div class="reveal relative mx-auto h-[430px] w-full max-w-[520px] sm:h-[520px] lg:h-[580px] lg:max-w-none" data-delay="0.15">
        <Picture
          src="/images/splash-flat-cut.png"
          alt=""
          sizes="(max-width: 1023px) 95vw, 560px"
          widths={[640, 1000, 1400]}
          transparent
          loading="eager"
          fetchpriority="low"
          class="h-full w-full object-contain"
          pictureClass="absolute -left-[4%] top-[2%] block w-[108%] -rotate-3"
        />
        <div class="absolute right-0 top-0 h-[76%] w-[44%] overflow-hidden rounded-b-[1.5rem] rounded-t-full ring-1 ring-line/50">
          <Picture
            src="/images/hero-living-room.jpg"
            alt="Bright living room with a mustard-yellow sofa, arc lamp and plants"
            sizes="(max-width: 1023px) 44vw, 300px"
            widths={[480, 800, 1200, 1280]}
            loading="eager"
            fetchpriority="high"
            width={1280}
            height={1920}
            class="h-full w-full object-cover"
            pictureClass="block h-full w-full"
          />
        </div>
        <Picture
          src="/images/hero-painter-cut.png"
          alt="Smiling professional painter in navy overalls holding a paint roller and a bucket of yellow paint"
          sizes="(max-width: 1023px) 62vw, 420px"
          widths={[480, 720, 841]}
          transparent
          loading="eager"
          fetchpriority="high"
          width={841}
          height={1688}
          class="h-full w-auto object-contain"
          pictureClass="absolute bottom-0 left-[4%] z-10 block h-[97%]"
        />
        <div class="absolute bottom-[15%] left-0 z-20 flex items-center gap-3 rounded-2xl bg-navy px-4 py-3 shadow-xl">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white/10 text-sun">
            <Icon name="trophy" class="h-5 w-5" />
          </span>
          <span>
            <span class="block text-base font-bold leading-tight text-white">10+ Years</span>
            <span class="block text-xs text-white/70">of Experience</span>
          </span>
        </div>
        <svg viewBox="0 0 100 80" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="absolute -top-1 right-[6%] z-20 hidden w-14 -scale-x-100 text-navy/40 sm:block" aria-hidden="true">
          <path d="M8 8 C 40 30, 66 44, 88 62" />
          <path d="M74 58 L 89 63 L 86 47" />
        </svg>
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <section class="bg-white pb-4" aria-label="Why choose Painter">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal grid grid-cols-1 gap-x-6 gap-y-6 rounded-3xl bg-white px-6 py-7 shadow-[0_18px_45px_-18px_rgba(12,21,38,0.25)] ring-1 ring-line sm:grid-cols-2 sm:px-8 lg:grid-cols-4 lg:divide-x lg:divide-line">
        {features.map((f, i) => (
          <div class="flex items-start gap-4 lg:px-2 lg:first:pl-0">
            <span class={`grid h-12 w-12 shrink-0 place-items-center rounded-2xl ${featureChipColors[i]}`}>
              <Icon name={f.icon as 'clock' | 'tag' | 'sparkles' | 'heart'} class="h-6 w-6" />
            </span>
            <span>
              <span class="block text-[15px] font-semibold leading-snug text-ink">{f.title}</span>
              <span class="mt-1 block text-sm leading-relaxed text-muted">{f.text}</span>
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="bg-white pb-20 pt-16 sm:pt-20" aria-labelledby="services-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mx-auto max-w-xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-600">What We Do</p>
        <h2 id="services-heading" class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">Our Painting Services</h2>
        <p class="mt-3 text-base leading-relaxed text-muted">
          From homes to businesses, we provide end-to-end painting solutions tailored to your needs.
        </p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {homeServices.map((s, i) => (
          <article class="reveal group overflow-hidden rounded-3xl bg-white ring-1 ring-line transition-shadow duration-300 hover:shadow-[0_20px_45px_-18px_rgba(12,21,38,0.3)]" data-delay={String(i * 0.1)}>
            <div class="h-48 overflow-hidden sm:h-52">
              <Picture
                src={s.image}
                alt={s.title}
                sizes="(max-width: 639px) 92vw, (max-width: 1023px) 46vw, 380px"
                widths={[480, 800, 1200]}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                pictureClass="block h-full w-full"
              />
            </div>
            <div class="relative px-6 pb-6">
              <span class={`relative z-10 -mt-7 grid h-14 w-14 place-items-center rounded-full ring-4 ring-white ${chipColors[i]}`}>
                <Icon name={s.icon as 'roller' | 'home' | 'building'} class="h-6 w-6" />
              </span>
              <h3 class="mt-4 text-lg font-bold text-ink">
                <a href={`/services/${s.slug}/`} class="transition-colors hover:text-amber-600">{s.title}</a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{s.short}</p>
              <a href={`/services/${s.slug}/`} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-ink transition-colors hover:text-amber-600">
                Learn More
                <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
              </a>
            </div>
          </article>
        ))}
      </div>
      <div class="reveal mt-10 text-center">
        <a href="/services/" class="inline-flex items-center gap-2 rounded-full bg-navy px-7 py-3 text-sm font-semibold text-white transition hover:bg-navy-2">
          View All Services
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Stats band -->
  <section class="relative" aria-label="Our numbers">
    <svg viewBox="0 0 1440 32" preserveAspectRatio="none" class="block h-6 w-full text-navy sm:h-8" aria-hidden="true">
      <path d="M0 32 L0 18 L34 14 L71 20 L118 10 L166 16 L214 8 L262 18 L311 12 L360 20 L407 9 L458 15 L505 19 L553 8 L602 14 L649 19 L697 10 L745 16 L792 20 L840 9 L889 15 L936 19 L984 11 L1033 17 L1081 8 L1129 14 L1178 19 L1226 10 L1274 16 L1323 12 L1370 18 L1440 14 L1440 32 Z" fill="currentColor" />
    </svg>
    <div class="bg-navy">
      <div class="mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-9 px-4 py-10 sm:px-6 lg:grid-cols-4 lg:divide-x lg:divide-white/10 lg:px-8 lg:py-12">
        {stats.map((s) => (
          <div class="reveal flex items-center gap-4 lg:justify-center lg:px-4 lg:first:pl-0">
            <span class="grid h-12 w-12 shrink-0 place-items-center text-sun">
              <Icon name={s.icon as 'users' | 'smile' | 'trophy' | 'pin'} class="h-8 w-8" />
            </span>
            <span>
              <span class="block text-3xl font-extrabold leading-none text-white sm:text-4xl" data-count={String(s.value)} data-suffix={s.suffix}>{s.value}{s.suffix}</span>
              <span class="mt-1.5 block text-sm text-white/70">{s.label}</span>
            </span>
          </div>
        ))}
      </div>
    </div>
    <svg viewBox="0 0 1440 32" preserveAspectRatio="none" class="block h-6 w-full rotate-180 text-navy sm:h-8" aria-hidden="true">
      <path d="M0 32 L0 18 L34 14 L71 20 L118 10 L166 16 L214 8 L262 18 L311 12 L360 20 L407 9 L458 15 L505 19 L553 8 L602 14 L649 19 L697 10 L745 16 L792 20 L840 9 L889 15 L936 19 L984 11 L1033 17 L1081 8 L1129 14 L1178 19 L1226 10 L1274 16 L1323 12 L1370 18 L1440 14 L1440 32 Z" fill="currentColor" />
    </svg>
  </section>

  <!-- Why choose us -->
  <section class="bg-white py-16 sm:py-20" aria-labelledby="why-heading">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-[1fr_auto_1fr] lg:gap-8 lg:px-8">
      <div class="reveal">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-600">Why Choose Us</p>
        <h2 id="why-heading" class="mt-3 text-3xl font-bold leading-[1.15] tracking-tight text-ink sm:text-4xl">
          We Bring <span class="swoosh font-script font-bold text-sun-deep">Color</span><br />
          To Your World
        </h2>
        <ul class="mt-6 space-y-3.5">
          {whyChooseUs.map((item) => (
            <li class="flex items-center gap-3 text-[15px] font-medium text-ink">
              <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-sun text-navy">
                <Icon name="check" class="h-3.5 w-3.5" />
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="reveal mx-auto w-full max-w-[420px] lg:max-w-[380px]" data-delay="0.1">
        <Picture
          src="/images/chair-scene-cut.png"
          alt="Cream armchair with a mustard cushion, side table with a plant, and a mustard pendant lamp"
          sizes="(max-width: 1023px) 88vw, 380px"
          widths={[480, 800, 1200]}
          transparent
          width={1361}
          height={1223}
          class="h-auto w-full object-contain"
        />
      </div>

      <div class="reveal relative" data-delay="0.2">
        <svg viewBox="0 0 24 200" preserveAspectRatio="none" class="absolute -left-4 top-0 hidden h-full w-6 text-navy sm:block" aria-hidden="true">
          <path d="M24 0 H10 L14 18 L7 38 L15 58 L8 78 L14 98 L6 118 L13 138 L7 158 L12 178 L9 200 H24 Z" fill="currentColor" />
        </svg>
        <div class="relative overflow-hidden rounded-[2rem] bg-navy p-7 sm:p-8">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white/10 text-sun">
            <Icon name="roller" class="h-6 w-6" />
          </span>
          <h3 class="mt-5 text-2xl font-bold leading-snug text-white">Ready to Transform Your Space?</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-white/70">
            Let&apos;s make your walls beautiful.<br />
            Get a free quote today!
          </p>
          <a href="/contact/" class="mt-6 inline-flex items-center gap-2 rounded-full bg-sun px-6 py-3 text-sm font-semibold text-navy transition hover:bg-sun-deep">
            Get a Free Quote
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <svg viewBox="0 0 100 80" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="absolute bottom-6 right-6 w-12 text-white/30" aria-hidden="true">
            <path d="M8 8 C 40 30, 66 44, 88 62" />
            <path d="M74 58 L 89 63 L 86 47" />
          </svg>
        </div>
      </div>
    </div>
  </section>
</Layout>
