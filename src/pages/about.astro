---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { site, stats, processSteps, team, testimonials, whyChooseUs } from '../data/site';

const aboutLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  mainEntity: {
    '@type': 'HousePainter',
    '@id': `${site.url}/#business`,
    name: site.name,
    url: `${site.url}/`,
    description: site.description,
  },
};
---

<Layout
  title="About Us — Painters Who Treat Your Home Like Their Own | Painter"
  description="Painter is a team of skilled, friendly painters with 10+ years of experience and 500+ projects. Neat, on time, and obsessed with a flawless finish."
  extraJsonLd={[aboutLd]}
>
  <PageHero
    eyebrow="About Us"
    title="Painters Who Treat Your Home Like Their Own"
    description="A small team with big standards — neat, honest, on time, and a little obsessed with perfect edges."
  />

  <section class="bg-white py-14 sm:py-16">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-12 lg:px-8">
      <div class="reveal overflow-hidden rounded-3xl ring-1 ring-line">
        <Picture
          src="/images/about-action.jpg"
          alt="Two Painter crew members painting a sunny room yellow"
          sizes="(max-width: 1023px) 92vw, 46vw"
          widths={[480, 800, 1200, 1600]}
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/3] w-full object-cover"
          pictureClass="block"
        />
      </div>
      <div class="reveal" data-delay="0.1">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-600">Our Story</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">Started With One Roller. Still Chasing Perfect Walls.</h2>
        <p class="mt-4 text-base leading-relaxed text-muted">
          Painter began in 2016 with one van, one roller, and a simple rule: leave every room better than you found it.
          Ten years and 500+ projects later, that rule has not changed — only the team around it has grown.
        </p>
        <p class="mt-3 text-base leading-relaxed text-muted">
          We are painters, not salespeople. We show up on time, protect your home like it is our own, use paints we would
          put in our own kids&apos; rooms, and we do not call a job done until you love the result.
        </p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {whyChooseUs.map((item) => (
            <li class="flex items-center gap-2.5 text-[15px] font-medium text-ink">
              <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-sun text-navy">
                <Icon name="check" class="h-3.5 w-3.5" />
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-cream py-14 sm:py-16" aria-label="Our numbers">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-9 px-4 sm:px-6 lg:grid-cols-4 lg:px-8">
      {stats.map((s) => (
        <div class="reveal flex items-center gap-4">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-white text-sun-deep ring-1 ring-line">
            <Icon name={s.icon as 'users' | 'smile' | 'trophy' | 'pin'} class="h-6 w-6" />
          </span>
          <span>
            <span class="block text-3xl font-extrabold leading-none text-ink" data-count={String(s.value)} data-suffix={s.suffix}>{s.value}{s.suffix}</span>
            <span class="mt-1.5 block text-sm text-muted">{s.label}</span>
          </span>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-white py-14 sm:py-16" aria-labelledby="process-heading" id="process">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mx-auto max-w-xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-600">How It Works</p>
        <h2 id="process-heading" class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">From Quote to Flawless Finish</h2>
      </div>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {processSteps.map((step, i) => (
          <li class="reveal relative rounded-3xl bg-cream p-6 ring-1 ring-line" data-delay={String(i * 0.1)}>
            <span class="grid h-11 w-11 place-items-center rounded-full bg-sun text-base font-extrabold text-navy">{i + 1}</span>
            <h3 class="mt-4 text-base font-bold text-ink">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-cream py-14 sm:py-16" aria-labelledby="team-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mx-auto max-w-xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-600">The Crew</p>
        <h2 id="team-heading" class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">Meet the People Behind the Paint</h2>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {team.map((m, i) => (
          <article class="reveal rounded-3xl bg-white p-6 text-center ring-1 ring-line" data-delay={String(i * 0.1)}>
            <Picture
              src={m.avatar}
              alt={`Portrait of ${m.name}`}
              sizes="96px"
              widths={[96, 160]}
              class="mx-auto h-24 w-24 rounded-full object-cover ring-4 ring-sun-soft"
            />
            <h3 class="mt-4 text-lg font-bold text-ink">{m.name}</h3>
            <p class="mt-0.5 text-sm font-medium text-amber-600">{m.role}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{m.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-16" aria-labelledby="testimonials-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mx-auto max-w-xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-600">Testimonials</p>
        <h2 id="testimonials-heading" class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">500+ Happy Clients. Here&apos;s Why.</h2>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {testimonials.map((t, i) => (
          <figure class="reveal rounded-3xl bg-cream p-6 ring-1 ring-line sm:p-7" data-delay={String((i % 2) * 0.1)}>
            <span class="flex gap-1 text-sun" role="img" aria-label="Rated 5 out of 5 stars">
              <Icon name="star" class="h-4 w-4" />
              <Icon name="star" class="h-4 w-4" />
              <Icon name="star" class="h-4 w-4" />
              <Icon name="star" class="h-4 w-4" />
              <Icon name="star" class="h-4 w-4" />
            </span>
            <blockquote class="mt-4 text-[15px] leading-relaxed text-ink">&ldquo;{t.quote}&rdquo;</blockquote>
            <figcaption class="mt-5 flex items-center gap-3">
              {t.avatar ? (
                <Picture src={t.avatar} alt="" sizes="44px" widths={[96, 160]} class="h-11 w-11 rounded-full object-cover ring-2 ring-white" />
              ) : (
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-sun text-sm font-bold text-navy ring-2 ring-white" aria-hidden="true">{t.initials ?? t.name.slice(0, 1)}</span>
              )}
              <span>
                <span class="block text-sm font-bold text-ink">{t.name}</span>
                <span class="block text-xs text-muted">{t.role}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
