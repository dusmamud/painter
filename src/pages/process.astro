---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { site, processDetail, protectionList } from '../data/site';

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How Painter paints your home',
  description: 'From free quote to final walkthrough: the five steps of every Painter project.',
  step: processDetail.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.text })),
};

const schedule = [
  { day: 'Day 1', task: 'Protect & prep', detail: 'Furniture moved, floors covered, walls washed, filled and sanded.' },
  { day: 'Day 2', task: 'Prime & first coat', detail: 'Primer where needed, then the first full coat on every wall.' },
  { day: 'Day 3', task: 'Second coat & trim', detail: 'Second coat, crisp trim lines, doors and touch-ups.' },
  { day: 'Day 4', task: 'Detail & check-in', detail: 'Detail pass with the crew lead, tweaks while we are still on site.' },
  { day: 'Day 5', task: 'Walkthrough & handover', detail: 'Joint inspection, clean-up, furniture back, warranty in writing.' },
];
---

<Layout
  title="Our Painting Process — From Quote to Flawless Finish | Painter"
  description="Five clear steps, no surprises: free visit, meticulous prep, painting day, check-ins as we go, and a joint walkthrough with a 5-year warranty."
  extraJsonLd={[howToLd]}
>
  <PageHero
    eyebrow="How It Works"
    title="A Process With No Surprises"
    description="You always know what happens next, when it happens, and what it costs. Here is the exact path every Painter project follows."
  />

  <section class="bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ol class="relative space-y-8 before:absolute before:bottom-6 before:left-[27px] before:top-6 before:w-px before:bg-line sm:space-y-10 sm:before:left-[31px]">
        {processDetail.map((step, i) => (
          <li class="reveal relative flex gap-5 sm:gap-7">
            <span class="z-10 grid h-14 w-14 shrink-0 place-items-center rounded-full bg-sun text-lg font-extrabold text-navy ring-8 ring-white sm:h-16 sm:w-16">{i + 1}</span>
            <div class="min-w-0 flex-1 rounded-3xl bg-cream p-5 ring-1 ring-line sm:p-6">
              <h2 class="text-lg font-bold text-ink sm:text-xl">{step.title}</h2>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{step.text}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {step.details.map((d) => (
                  <li class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1.5 text-xs font-medium text-ink ring-1 ring-line">
                    <Icon name="check" class="h-3.5 w-3.5 text-sun-deep" />
                    {d}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-cream py-14 sm:py-16" aria-labelledby="protect-heading">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14 lg:px-8">
      <div class="reveal">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-600">Your Home, Protected</p>
        <h2 id="protect-heading" class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">We Treat Your Home Like Our Own</h2>
        <p class="mt-3 text-base leading-relaxed text-muted">
          Paint belongs on walls — nowhere else. Every job starts with protection, and every day ends with a tidy-up.
        </p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {protectionList.map((item) => (
            <li class="flex items-start gap-2.5 text-[15px] font-medium text-ink">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-sun text-navy">
                <Icon name="check" class="h-3 w-3" />
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal" data-delay="0.1">
        <h3 class="text-lg font-bold text-ink">A typical whole-home week</h3>
        <ol class="mt-4 space-y-3">
          {schedule.map((s) => (
            <li class="flex gap-4 rounded-2xl bg-white p-4 ring-1 ring-line">
              <span class="w-14 shrink-0 text-sm font-bold text-sun-deep">{s.day}</span>
              <span>
                <span class="block text-sm font-semibold text-ink">{s.task}</span>
                <span class="mt-0.5 block text-sm leading-relaxed text-muted">{s.detail}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <ContactCTA title="Ready to Start Step One?" text="Book a free visit — we'll measure, talk colors, and leave you a fixed quote." />
</Layout>
