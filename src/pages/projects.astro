---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { projects } from '../data/site';

const filters = ['All', 'Interior', 'Exterior', 'Commercial'];
---

<Layout
  title="Our Projects — Recent Painting Work | Painter"
  description="Browse recent interior, exterior and commercial painting projects — homes, offices and shops transformed with flawless finishes."
>
  <PageHero
    eyebrow="Our Work"
    title="Recent Projects We're Proud Of"
    description="Real rooms, real buildings, real transformations. Filter by project type to find inspiration for your space."
  />

  <section class="bg-white py-14 sm:py-16" aria-label="Project gallery">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal flex flex-wrap gap-2.5" role="group" aria-label="Filter projects">
        {filters.map((f) => (
          <button
            type="button"
            data-filter-btn={f}
            aria-pressed={f === 'All' ? 'true' : 'false'}
            class={`rounded-full px-5 py-2.5 text-sm font-semibold ring-1 ring-line transition ${f === 'All' ? 'bg-navy text-white' : 'bg-white text-muted hover:text-ink'}`}
          >
            {f}
          </button>
        ))}
      </div>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => (
          <article data-category={p.category} class="reveal group overflow-hidden rounded-3xl bg-white ring-1 ring-line transition-shadow duration-300 hover:shadow-[0_20px_45px_-18px_rgba(12,21,38,0.3)]">
            <a href={`/projects/${p.slug}/`} class="relative block h-52 overflow-hidden sm:h-56" tabindex="-1" aria-hidden="true">
              <Picture
                src={p.image}
                alt=""
                sizes="(max-width: 639px) 92vw, (max-width: 1023px) 46vw, 380px"
                widths={[480, 800, 1200]}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                pictureClass="block h-full w-full"
              />
              <span class="absolute left-4 top-4 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-navy">{p.category}</span>
            </a>
            <div class="px-6 pb-6 pt-5">
              <h2 class="text-lg font-bold text-ink">
                <a href={`/projects/${p.slug}/`} class="transition-colors hover:text-amber-600">{p.title}</a>
              </h2>
              <p class="mt-1 flex items-center gap-1.5 text-xs font-medium text-muted">
                <Icon name="pin" class="h-3.5 w-3.5" />
                {p.location}
              </p>
              <p class="mt-2.5 text-sm leading-relaxed text-muted">{p.blurb}</p>
              <a href={`/projects/${p.slug}/`} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-ink transition-colors hover:text-amber-600">
                View Case Study
                <Icon name="arrow" class="h-4 w-4" />
              </a>
            </div>
          </article>
        ))}
      </div>
      <p class="reveal mt-10 text-center text-sm text-muted">
        Like what you see? <a href="/contact/" class="font-semibold text-ink underline decoration-sun decoration-2 underline-offset-4 hover:text-amber-600">Get a free quote</a> for your project.
      </p>
    </div>
  </section>

  <ContactCTA />
</Layout>
