---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { site, contact, services, testimonials } from '../data/site';

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  mainEntity: {
    '@type': 'HousePainter',
    '@id': `${site.url}/#business`,
    name: site.name,
    url: `${site.url}/`,
    telephone: contact.phoneDisplay,
    email: contact.email,
  },
};

const inputClass =
  'w-full rounded-xl border border-line bg-white px-4 py-3 text-sm text-ink placeholder:text-muted/70 outline-none transition focus:border-sun-deep focus:ring-2 focus:ring-sun/60';
---

<Layout
  title="Contact & Free Quote | Painter"
  description="Get a free painting quote: call, email, or send the quote form. We reply within one business day. Based in Paintville, CA, serving 25+ cities."
  extraJsonLd={[contactLd]}
>
  <PageHero
    eyebrow="Contact"
    title="Get Your Free Quote Today"
    description="Tell us about your space and we'll come back with a clear, fixed quote — usually within one business day."
  />

  <section class="bg-white py-14 sm:py-16">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-5 lg:gap-12 lg:px-8">
      <div class="reveal space-y-4 lg:col-span-2">
        <a href={contact.phoneHref} class="flex items-start gap-4 rounded-3xl bg-cream p-5 ring-1 ring-line transition hover:ring-sun-deep">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-sun text-navy"><Icon name="phone" class="h-5 w-5" /></span>
          <span>
            <span class="block text-sm font-semibold text-ink">Call us</span>
            <span class="mt-0.5 block text-sm text-muted">{contact.phoneDisplay}</span>
            <span class="mt-0.5 block text-xs text-muted">{contact.hours}</span>
          </span>
        </a>
        <a href={contact.smsHref} class="flex items-start gap-4 rounded-3xl bg-cream p-5 ring-1 ring-line transition hover:ring-sun-deep">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-sun text-navy"><Icon name="chat" class="h-5 w-5" /></span>
          <span>
            <span class="block text-sm font-semibold text-ink">Text us</span>
            <span class="mt-0.5 block text-sm text-muted">{contact.phoneDisplay}</span>
            <span class="mt-0.5 block text-xs text-muted">Photos welcome — send a picture of the room</span>
          </span>
        </a>
        <a href={`mailto:${contact.email}`} class="flex items-start gap-4 rounded-3xl bg-cream p-5 ring-1 ring-line transition hover:ring-sun-deep">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-sun text-navy"><Icon name="mail" class="h-5 w-5" /></span>
          <span>
            <span class="block text-sm font-semibold text-ink">Email us</span>
            <span class="mt-0.5 block text-sm text-muted">{contact.email}</span>
            <span class="mt-0.5 block text-xs text-muted">Replies within one business day</span>
          </span>
        </a>
        <div class="flex items-start gap-4 rounded-3xl bg-cream p-5 ring-1 ring-line">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-sun text-navy"><Icon name="pin" class="h-5 w-5" /></span>
          <span>
            <span class="block text-sm font-semibold text-ink">Visit us</span>
            <span class="mt-0.5 block text-sm text-muted">{contact.location}</span>
            <span class="mt-0.5 block text-xs text-muted">Serving 25+ cities nearby</span>
          </span>
        </div>
        <div class="rounded-3xl bg-navy p-5 text-white">
          <p class="flex items-center gap-2 text-sm font-semibold"><Icon name="shield" class="h-5 w-5 text-sun" /> Our promise</p>
          <p class="mt-2 text-sm leading-relaxed text-white/70">
            Fixed quotes, on-time arrival, and a 5-year workmanship warranty on every project. If you are not happy, we
            come back and make it right — free.
          </p>
        </div>
      </div>

      <div class="reveal lg:col-span-3" data-delay="0.1">
        <form
          data-mailto-form
          data-mailto={contact.email}
          data-subject="Quote request from painter-static.pages.dev"
          class="rounded-3xl bg-white p-6 ring-1 ring-line shadow-[0_18px_45px_-18px_rgba(12,21,38,0.25)] sm:p-8"
          novalidate
        >
          <h2 class="text-xl font-bold text-ink">Request a free quote</h2>
          <p class="mt-1.5 text-sm text-muted">Fields marked * are required.</p>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div>
              <label for="q-name" class="mb-1.5 block text-sm font-medium text-ink">Your name *</label>
              <input id="q-name" name="name" type="text" required autocomplete="name" placeholder="Jane Smith" class={inputClass} />
            </div>
            <div>
              <label for="q-email" class="mb-1.5 block text-sm font-medium text-ink">Email *</label>
              <input id="q-email" name="email" type="email" required autocomplete="email" placeholder="jane@example.com" class={inputClass} />
            </div>
            <div>
              <label for="q-phone" class="mb-1.5 block text-sm font-medium text-ink">Phone</label>
              <input id="q-phone" name="phone" type="tel" autocomplete="tel" placeholder="+1 234 567 8900" class={inputClass} />
            </div>
            <div>
              <label for="q-service" class="mb-1.5 block text-sm font-medium text-ink">Service needed *</label>
              <select id="q-service" name="service" required class={inputClass}>
                <option value="" disabled selected>Choose a service</option>
                {services.map((s) => <option value={s.title}>{s.title}</option>)}
                <option value="Something else">Something else</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label for="q-message" class="mb-1.5 block text-sm font-medium text-ink">Tell us about your project *</label>
              <textarea id="q-message" name="message" required rows="5" placeholder="Which rooms or areas? Rough size? Any colors in mind? When would you like to start?" class={`${inputClass} resize-y`}></textarea>
            </div>
          </div>
          <button type="submit" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-sun px-6 py-3.5 text-sm font-semibold text-navy transition hover:bg-sun-deep sm:w-auto">
            Request My Free Quote
            <Icon name="arrow" class="h-4 w-4" />
          </button>
          <p class="mt-4 text-xs leading-relaxed text-muted">
            Submitting opens your email app with the message ready to send — nothing is sent automatically. We never share
            your details. See our <a href="/privacy/" class="underline underline-offset-2 hover:text-ink">Privacy Policy</a>.
          </p>
        </form>
      </div>
    </div>
  </section>

  <section class="bg-cream py-14 sm:py-16" aria-label="What clients say">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
      <div class="reveal">
        <TestimonialCard name={testimonials[1].name} role={testimonials[1].role} avatar={testimonials[1].avatar} initials={testimonials[1].initials} quote={testimonials[1].quote} />
      </div>
      <p class="reveal mt-6 text-center text-sm text-muted">
        4.9 stars from 380+ verified reviews — <a href="/reviews/" class="font-semibold text-ink underline decoration-sun decoration-2 underline-offset-4 hover:text-amber-600">read them all</a>.
      </p>
    </div>
  </section>
</Layout>
