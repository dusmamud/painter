---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Picture from '../../components/Picture.astro';
import Icon from '../../components/Icon.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { site, services } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);
const chipColors: Record<string, string> = {
  'interior-painting': 'bg-sun text-navy',
  'exterior-painting': 'bg-[#3d7bfa] text-white',
  'commercial-painting': 'bg-[#7c5cf0] text-white',
  'color-consultation': 'bg-[#e8598b] text-white',
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.short,
  provider: {
    '@type': 'HousePainter',
    '@id': `${site.url}/#business`,
    name: site.name,
    url: `${site.url}/`,
  },
  areaServed: 'Paintville, CA',
  url: `${site.url}/services/${service.slug}/`,
};
---

<Layout
  title={`${service.title} | Painter`}
  description={service.description}
  ogImage={service.image}
  extraJsonLd={[serviceLd]}
>
  <PageHero eyebrow="Our Services" title={service.title} description={service.short} />

  <section class="bg-white py-14 sm:py-16">
    <div class="mx-auto grid max-w-7xl items-start gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-12 lg:px-8">
      <div class="reveal overflow-hidden rounded-3xl ring-1 ring-line">
        <Picture
          src={service.image}
          alt={service.title}
          sizes="(max-width: 1023px) 92vw, 46vw"
          widths={[480, 800, 1200, 1600]}
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/3] w-full object-cover"
          pictureClass="block"
        />
      </div>
      <div class="reveal" data-delay="0.1">
        <span class={`grid h-14 w-14 place-items-center rounded-full ${chipColors[service.slug]}`}>
          <Icon name={service.icon as 'roller' | 'home' | 'building' | 'palette'} class="h-6 w-6" />
        </span>
        <p class="mt-5 text-base leading-relaxed text-muted sm:text-lg">{service.description}</p>
        <p class="mt-5 inline-flex items-center gap-2 rounded-full bg-sun-soft px-4 py-2 text-sm font-semibold text-navy">{service.priceFrom}</p>
        <h2 class="mt-8 text-xl font-bold text-ink">What&apos;s included</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {service.includes.map((item) => (
            <li class="flex items-start gap-2.5 text-[15px] font-medium text-ink">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-sun text-navy">
                <Icon name="check" class="h-3 w-3" />
              </span>
              {item}
            </li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact/" class="inline-flex items-center gap-2 rounded-full bg-sun px-6 py-3 text-sm font-semibold text-navy transition hover:bg-sun-deep">
            Get a Free Quote
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a href="/pricing/" class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 text-sm font-semibold text-ink transition hover:border-ink">
            See Pricing
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream py-14 sm:py-16" aria-labelledby="others-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="others-heading" class="reveal text-2xl font-bold tracking-tight text-ink sm:text-3xl">Other Services</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((s) => (
          <article class="reveal group overflow-hidden rounded-3xl bg-white ring-1 ring-line transition-shadow duration-300 hover:shadow-[0_20px_45px_-18px_rgba(12,21,38,0.3)]">
            <div class="h-44 overflow-hidden">
              <Picture
                src={s.image}
                alt={s.title}
                sizes="(max-width: 639px) 92vw, (max-width: 1023px) 46vw, 380px"
                widths={[480, 800, 1200]}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                pictureClass="block h-full w-full"
              />
            </div>
            <div class="px-6 pb-6 pt-5">
              <h3 class="text-lg font-bold text-ink">
                <a href={`/services/${s.slug}/`} class="transition-colors hover:text-amber-600">{s.title}</a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{s.short}</p>
              <a href={`/services/${s.slug}/`} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-ink transition-colors hover:text-amber-600">
                Learn More
                <Icon name="arrow" class="h-4 w-4" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
