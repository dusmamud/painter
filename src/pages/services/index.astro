---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Picture from '../../components/Picture.astro';
import Icon from '../../components/Icon.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import { services, processSteps, testimonials } from '../../data/site';

const chipColors = ['bg-sun text-navy', 'bg-[#3d7bfa] text-white', 'bg-[#7c5cf0] text-white', 'bg-[#1e8a4c] text-white', 'bg-[#e8598b] text-white'];
---

<Layout
  title="Our Painting Services — Interior, Exterior & Commercial | Painter"
  description="Interior painting, exterior painting, commercial painting and color consultation — end-to-end painting solutions with premium, eco-friendly paints and a 5-year warranty."
>
  <PageHero
    eyebrow="What We Do"
    title="Painting Services for Every Space"
    description="From a single room to a whole building — professional crews, premium paints, and a flawless finish, every time."
  />

  <section class="bg-white py-14 sm:py-16" aria-label="All services">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2">
        {services.map((s, i) => (
          <article class="reveal group flex flex-col overflow-hidden rounded-3xl bg-white ring-1 ring-line transition-shadow duration-300 hover:shadow-[0_20px_45px_-18px_rgba(12,21,38,0.3)]">
            <div class="h-52 overflow-hidden sm:h-60">
              <Picture
                src={s.image}
                alt={s.title}
                sizes="(max-width: 639px) 92vw, 46vw"
                widths={[480, 800, 1200]}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                pictureClass="block h-full w-full"
              />
            </div>
            <div class="relative flex flex-1 flex-col px-6 pb-6">
              <span class={`relative z-10 -mt-7 grid h-14 w-14 place-items-center rounded-full ring-4 ring-white ${chipColors[i]}`}>
                <Icon name={s.icon as 'roller' | 'home' | 'building' | 'brush' | 'palette'} class="h-6 w-6" />
              </span>
              <h2 class="mt-4 text-xl font-bold text-ink">
                <a href={`/services/${s.slug}/`} class="transition-colors hover:text-amber-600">{s.title}</a>
              </h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{s.description}</p>
              <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
                <span class="text-sm font-semibold text-ink">{s.priceFrom}</span>
                <a href={`/services/${s.slug}/`} class="inline-flex items-center gap-1.5 text-sm font-semibold text-ink transition-colors hover:text-amber-600">
                  Learn More
                  <Icon name="arrow" class="h-4 w-4" />
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white pb-14 sm:pb-16" aria-label="What clients say">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="reveal">
          <TestimonialCard name={testimonials[0].name} role={testimonials[0].role} avatar={testimonials[0].avatar} initials={testimonials[0].initials} quote={testimonials[0].quote} />
        </div>
        <div class="reveal" data-delay="0.1">
          <TestimonialCard name={testimonials[2].name} role={testimonials[2].role} avatar={testimonials[2].avatar} initials={testimonials[2].initials} quote={testimonials[2].quote} />
        </div>
      </div>
      <p class="reveal mt-6 text-center text-sm text-muted">
        4.9 stars from 380+ verified reviews — <a href="/reviews/" class="font-semibold text-ink underline decoration-sun decoration-2 underline-offset-4 hover:text-amber-600">read them all</a>.
      </p>
    </div>
  </section>

  <section class="bg-cream py-14 sm:py-16" aria-labelledby="process-heading" id="process">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mx-auto max-w-xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-600">How It Works</p>
        <h2 id="process-heading" class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">From Quote to Flawless Finish</h2>
      </div>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {processSteps.map((step, i) => (
          <li class="reveal relative rounded-3xl bg-white p-6 ring-1 ring-line" data-delay={String(i * 0.1)}>
            <span class="grid h-11 w-11 place-items-center rounded-full bg-sun text-base font-extrabold text-navy">{i + 1}</span>
            <h3 class="mt-4 text-base font-bold text-ink">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ContactCTA />
</Layout>
