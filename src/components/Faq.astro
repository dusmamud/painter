---
interface Props {
  faqs: { q: string; a: string }[];
}

const { faqs } = Astro.props;
---

<div data-faq-group class="space-y-3">
  {faqs.map((f, i) => (
    <div data-faq-item class="overflow-hidden rounded-2xl bg-white ring-1 ring-line">
      <h3>
        <button
          type="button"
          data-faq-btn
          aria-expanded={i === 0 ? 'true' : 'false'}
          aria-controls={`faq-panel-${i}`}
          id={`faq-btn-${i}`}
          class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left text-[15px] font-semibold text-ink sm:px-6"
        >
          {f.q}
          <span data-faq-icon class={`grid h-8 w-8 shrink-0 place-items-center rounded-full bg-sun-soft text-navy transition-transform duration-300 ${i === 0 ? 'rotate-45' : ''}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="h-4 w-4" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          </span>
        </button>
      </h3>
      <div
        id={`faq-panel-${i}`}
        role="region"
        aria-labelledby={`faq-btn-${i}`}
        data-faq-panel
        class={`grid transition-all duration-300 ${i === 0 ? 'grid-rows-[1fr]' : 'grid-rows-[0fr]'}`}
      >
        <div class="overflow-hidden">
          <p class="px-5 pb-5 text-sm leading-relaxed text-muted sm:px-6">{f.a}</p>
        </div>
      </div>
    </div>
  ))}
</div>
