---
import Icon from './Icon.astro';
import { contact } from '../data/site';
---

<section class="bg-white pb-16 sm:pb-20" aria-label="Newsletter">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal relative overflow-hidden rounded-[2rem] bg-cream px-6 py-10 ring-1 ring-line sm:px-10">
      <img src="/images/splash-flat-cut-640.png" alt="" aria-hidden="true" loading="lazy" decoding="async" class="pointer-events-none absolute -right-10 -top-12 w-56 rotate-12 opacity-30 select-none" />
      <div class="relative mx-auto max-w-xl text-center">
        <h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">Paint Tips &amp; Color Ideas, Monthly</h2>
        <p class="mt-2.5 text-sm leading-relaxed text-muted sm:text-base">
          One short email a month: color trends, care tips and seasonal offers. No spam, unsubscribe anytime.
        </p>
        <form data-mailto-form data-mailto={contact.email} data-subject="Newsletter signup" class="mx-auto mt-6 flex max-w-md flex-col gap-3 sm:flex-row" novalidate>
          <label class="sr-only" for="newsletter-email">Email address</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="w-full flex-1 rounded-full border border-line bg-white px-5 py-3 text-sm text-ink outline-none transition placeholder:text-muted/70 focus:border-sun-deep focus:ring-2 focus:ring-sun/60"
          />
          <button type="submit" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-navy px-6 py-3 text-sm font-semibold text-white transition hover:bg-navy-2">
            Subscribe
            <Icon name="arrow" class="h-4 w-4" />
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
