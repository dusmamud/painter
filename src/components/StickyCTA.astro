---
import Icon from './Icon.astro';
import { contact } from '../data/site';
---

<div
  id="sticky-cta"
  class="fixed inset-x-0 bottom-0 z-[70] border-t border-line bg-white/95 pb-[env(safe-area-inset-bottom)] shadow-[0_-8px_30px_-12px_rgba(12,21,38,0.3)] backdrop-blur transition-transform duration-300 md:hidden"
>
  <div class="mx-auto grid max-w-xl grid-cols-2 gap-2.5 px-4 py-3">
    <a href={contact.phoneHref} class="inline-flex items-center justify-center gap-2 rounded-full border border-navy/20 px-4 py-3 text-sm font-semibold text-navy transition active:bg-cream">
      <Icon name="phone" class="h-4 w-4" />
      Call Now
    </a>
    <a href="/quote/" class="inline-flex items-center justify-center gap-2 rounded-full bg-sun px-4 py-3 text-sm font-semibold text-navy transition hover:bg-sun-deep">
      Free Quote
      <Icon name="arrow" class="h-4 w-4" />
    </a>
  </div>
</div>
