---
import Icon from './Icon.astro';
import { contact } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}

const { title = 'Ready to Transform Your Space?', text = "Let's make your walls beautiful. Get a free quote today!" } = Astro.props;
---

<section class="bg-white pb-16 sm:pb-20" aria-label="Get a quote">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal relative overflow-hidden rounded-[2rem] bg-navy px-6 py-10 sm:px-10 sm:py-12">
      <img src="/images/splash-flat-cut-640.png" alt="" aria-hidden="true" loading="lazy" decoding="async" class="pointer-events-none absolute -bottom-14 -right-12 w-64 rotate-12 opacity-90 select-none sm:w-80" />
      <div class="relative flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="max-w-lg text-2xl font-bold leading-snug text-white sm:text-3xl">{title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-white/70 sm:text-base">{text}</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a href="/contact/" class="inline-flex items-center gap-2 rounded-full bg-sun px-6 py-3 text-sm font-semibold text-navy transition hover:bg-sun-deep">
            Get a Free Quote
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a href={contact.phoneHref} class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-navy-2 px-6 py-3 text-sm font-semibold text-white transition hover:border-white">
            <Icon name="phone" class="h-4 w-4" />
            {contact.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
