---
import Picture from './Picture.astro';

interface Props {
  image: string;
  alt: string;
  beforeLabel?: string;
  afterLabel?: string;
  sizes?: string;
  widths?: number[];
  class?: string;
}

const {
  image,
  alt,
  beforeLabel = 'Before',
  afterLabel = 'After',
  sizes = '(max-width: 1023px) 92vw, 46vw',
  widths = [480, 800, 1200],
  class: cls,
} = Astro.props;
---

<div data-ba class={`group relative aspect-[4/3] select-none overflow-hidden rounded-3xl ring-1 ring-line ${cls ?? ''}`}>
  <Picture
    src={image}
    alt={alt}
    sizes={sizes}
    widths={widths}
    class="absolute inset-0 h-full w-full object-cover"
    pictureClass="absolute inset-0 block h-full w-full"
  />
  <div data-ba-before class="absolute inset-0" style="clip-path: inset(0 50% 0 0);">
    <Picture
      src={image}
      alt=""
      sizes={sizes}
      widths={widths}
      class="h-full w-full object-cover [filter:grayscale(0.65)_sepia(0.28)_brightness(0.82)_saturate(0.7)]"
      pictureClass="block h-full w-full"
    />
  </div>
  <span class="pointer-events-none absolute left-4 top-4 rounded-full bg-navy/80 px-3 py-1 text-xs font-semibold text-white backdrop-blur-sm">{beforeLabel}</span>
  <span class="pointer-events-none absolute right-4 top-4 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-navy">{afterLabel}</span>
  <div data-ba-handle class="pointer-events-none absolute inset-y-0 z-10 w-0.5 bg-white shadow-[0_0_12px_rgba(0,0,0,0.35)]" style="left: 50%;">
    <span class="absolute left-1/2 top-1/2 grid h-10 w-10 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-navy shadow-lg ring-1 ring-line">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="m9 6-4 6 4 6" /><path d="m15 6 4 6-4 6" /></svg>
    </span>
  </div>
  <input
    data-ba-range
    type="range"
    min="0"
    max="100"
    value="50"
    step="1"
    aria-label="Drag to compare before and after"
    class="absolute inset-0 z-20 h-full w-full cursor-ew-resize opacity-0"
  />
</div>
