---
import { site, contact, socials, services } from '../data/site';
import Icon from './Icon.astro';

const socialIcons: Record<string, string> = {
  Facebook: '<path d="M13.5 22v-8h2.8l.4-3.2h-3.2V8.7c0-.9.3-1.6 1.7-1.6h1.6V4.2c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4v2.7H7.5V14h2.9v8h3.1Z" />',
  Instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="17.2" cy="6.8" r="1.3" />',
  X: '<path d="M4 4l16 16M20 4L4 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />',
  LinkedIn:
    '<rect x="3" y="9" width="3.4" height="11" rx="1" /><circle cx="4.7" cy="5.4" r="2" /><path d="M10 20v-6.2c0-1.7 1.2-3 2.8-3s2.7 1.3 2.7 3V20h3.4v-6.6c0-3.4-2.1-5.4-5-5.4-1.5 0-2.7.7-3.4 1.8V9H10v11h3.4Z" />',
};
---

<footer class="relative overflow-hidden bg-navy text-white/70" data-hide-sticky>
  <div class="relative z-10 mx-auto max-w-7xl px-4 pb-10 pt-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_0.9fr_1fr_1fr_1.2fr]">
      <div>
        <a href="/" class="flex items-center gap-2" aria-label="Painter — home">
          <span class="grid h-10 w-10 place-items-center rounded-full bg-sun text-navy">
            <Icon name="roller" class="h-5 w-5" />
          </span>
          <span class="text-xl font-bold tracking-tight text-white">Painter</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed">
          Professional painting services that bring color, life, and happiness to your spaces.
        </p>
        <div class="mt-5 flex items-center gap-2">
          {socials.map((s) =>
            s.href === '#' ? (
              <span role="img" aria-label={s.label} class="grid h-11 w-11 place-items-center rounded-full border border-white/20 text-white/70">
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true" set:html={socialIcons[s.label]} />
              </span>
            ) : (
              <a href={s.href} aria-label={s.label} class="grid h-11 w-11 place-items-center rounded-full border border-white/20 text-white/70 transition hover:border-sun hover:text-sun">
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true" set:html={socialIcons[s.label]} />
              </a>
            ),
          )}
        </div>
      </div>

      <nav aria-label="Footer">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Quick Links</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a class="inline-block py-1 transition hover:text-sun" href="/">Home</a></li>
          <li><a class="inline-block py-1 transition hover:text-sun" href="/services/">Services</a></li>
          <li><a class="inline-block py-1 transition hover:text-sun" href="/projects/">Projects</a></li>
          <li><a class="inline-block py-1 transition hover:text-sun" href="/pricing/">Pricing</a></li>
          <li><a class="inline-block py-1 transition hover:text-sun" href="/reviews/">Reviews</a></li>
          <li><a class="inline-block py-1 transition hover:text-sun" href="/quote/">Get a Quote</a></li>
        </ul>
      </nav>

      <nav aria-label="Footer explore">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Explore</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a class="inline-block py-1 transition hover:text-sun" href="/about/">About Us</a></li>
          <li><a class="inline-block py-1 transition hover:text-sun" href="/process/">Our Process</a></li>
          <li><a class="inline-block py-1 transition hover:text-sun" href="/colors/">Color Visualizer</a></li>
          <li><a class="inline-block py-1 transition hover:text-sun" href="/areas/">Service Areas</a></li>
          <li><a class="inline-block py-1 transition hover:text-sun" href="/guarantee/">Our Guarantee</a></li>
          <li><a class="inline-block py-1 transition hover:text-sun" href="/blog/">Blog</a></li>
          <li><a class="inline-block py-1 transition hover:text-sun" href="/gallery/">Gallery</a></li>
          <li><a class="inline-block py-1 transition hover:text-sun" href="/team/">Our Team</a></li>
          <li><a class="inline-block py-1 transition hover:text-sun" href="/careers/">Careers</a></li>
          <li><a class="inline-block py-1 transition hover:text-sun" href="/faq/">FAQ</a></li>
          <li><a class="inline-block py-1 transition hover:text-sun" href="/book/">Book a Consultation</a></li>
        </ul>
      </nav>

      <nav aria-label="Footer services">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Our Services</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {services.map((s) => (
            <li><a class="inline-block py-1 transition hover:text-sun" href={`/services/${s.slug}/`}>{s.title}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Contact Us</h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a class="flex items-start gap-2.5 transition hover:text-sun" href={contact.phoneHref}>
              <Icon name="phone" class="mt-0.5 h-4 w-4 shrink-0 text-sun" />
              {contact.phoneDisplay}
            </a>
          </li>
          <li>
            <a class="flex items-start gap-2.5 transition hover:text-sun" href={`mailto:${contact.email}`}>
              <Icon name="mail" class="mt-0.5 h-4 w-4 shrink-0 text-sun" />
              {contact.email}
            </a>
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="pin" class="mt-0.5 h-4 w-4 shrink-0 text-sun" />
              <span>{contact.location}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 text-xs sm:flex-row">
      <p>© {site.year} {site.name}. All rights reserved.</p>
      <p class="flex items-center gap-5">
        <a class="inline-block py-1 transition hover:text-sun" href="/privacy/">Privacy Policy</a>
        <a class="inline-block py-1 transition hover:text-sun" href="/terms/">Terms &amp; Conditions</a>
      </p>
    </div>
  </div>
  <img src="/images/splash-flat-cut-640.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" class="pointer-events-none absolute -bottom-20 -right-6 w-40 rotate-12 opacity-90 select-none sm:w-52" />
</footer>
