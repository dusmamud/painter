---
import Picture from './Picture.astro';
import Icon from './Icon.astro';
import { paintColors } from '../data/site';

interface Props {
  rooms: { src: string; alt: string; label: string }[];
}

const { rooms } = Astro.props;
---

<div data-visualizer class="overflow-hidden rounded-3xl bg-white ring-1 ring-line">
  <div class="relative">
    <div data-viz-stage class="relative aspect-[4/3] overflow-hidden sm:aspect-[16/10]">
      {rooms.map((room, i) => (
        <div data-viz-room={i} class={i === 0 ? 'absolute inset-0' : 'absolute inset-0 hidden'}>
          <Picture
            src={room.src}
            alt={room.alt}
            sizes="(max-width: 1023px) 92vw, 640px"
            widths={[480, 800, 1200]}
            loading={i === 0 ? 'eager' : 'lazy'}
            class="h-full w-full object-cover"
            pictureClass="block h-full w-full"
          />
        </div>
      ))}
      <div data-viz-tint class="pointer-events-none absolute inset-0 mix-blend-color" style="background-color: #FFC61A; opacity: 0.45;"></div>
      <span data-viz-label class="absolute left-4 top-4 rounded-full bg-navy/80 px-3.5 py-1.5 text-xs font-semibold text-white backdrop-blur-sm">Sunshine · #FFC61A</span>
    </div>
    <div class="flex flex-wrap gap-2 border-t border-line bg-cream px-4 py-3">
      {rooms.map((room, i) => (
        <button
          type="button"
          data-viz-room-btn={i}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class={`rounded-full px-4 py-2 text-sm font-semibold ring-1 ring-line transition ${i === 0 ? 'bg-navy text-white' : 'bg-white text-muted hover:text-ink'}`}
        >
          {room.label}
        </button>
      ))}
    </div>
  </div>

  <div class="p-5 sm:p-6">
    <p class="text-sm font-semibold text-ink">Pick a color</p>
    <div class="mt-3 grid grid-cols-6 gap-2.5 sm:grid-cols-12" role="group" aria-label="Paint colors">
      {paintColors.map((c, i) => (
        <button
          type="button"
          data-viz-swatch={c.hex}
          data-viz-name={c.name}
          aria-label={`${c.name} ${c.hex}`}
          aria-pressed={i === 0 ? 'true' : 'false'}
          title={`${c.name} ${c.hex}`}
          class={`aspect-square w-full rounded-full ring-2 transition ${i === 0 ? 'ring-navy ring-offset-2' : 'ring-line hover:ring-navy/40'}`}
          style={`background-color: ${c.hex};`}
        />
      ))}
    </div>
    <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
      <label for="viz-intensity" class="flex flex-1 items-center gap-3 text-sm font-medium text-ink">
        <span class="shrink-0">Intensity</span>
        <input id="viz-intensity" data-viz-intensity type="range" min="0" max="80" value="45" step="1" class="h-2 w-full max-w-56 cursor-pointer accent-[#f0b400]" />
      </label>
      <a href="/book/" class="inline-flex items-center gap-2 rounded-full bg-sun px-5 py-2.5 text-sm font-semibold text-navy transition hover:bg-sun-deep">
        Try It On Your Walls — Free
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
    <p class="mt-4 text-xs leading-relaxed text-muted">
      Preview only — real paint varies with light, sheen and surface. A free consultation tests large swatches on your own walls before you decide.
    </p>
  </div>
</div>

<script>
  document.querySelectorAll('[data-visualizer]').forEach((root) => {
    const tint = root.querySelector<HTMLElement>('[data-viz-tint]');
    const label = root.querySelector<HTMLElement>('[data-viz-label]');
    const rooms = root.querySelectorAll<HTMLElement>('[data-viz-room]');
    const roomBtns = root.querySelectorAll<HTMLButtonElement>('[data-viz-room-btn]');
    const swatches = root.querySelectorAll<HTMLButtonElement>('[data-viz-swatch]');
    const intensity = root.querySelector<HTMLInputElement>('[data-viz-intensity]');
    let current = { name: 'Sunshine', hex: '#FFC61A' };

    const applyLabel = () => {
      if (label) label.textContent = `${current.name} · ${current.hex}`;
    };
    swatches.forEach((btn) => {
      btn.addEventListener('click', () => {
        current = { name: btn.dataset.vizName ?? '', hex: btn.dataset.vizSwatch ?? '#FFC61A' };
        if (tint) tint.style.backgroundColor = current.hex;
        applyLabel();
        swatches.forEach((b) => {
          const active = b === btn;
          b.setAttribute('aria-pressed', String(active));
          b.classList.toggle('ring-navy', active);
          b.classList.toggle('ring-offset-2', active);
          b.classList.toggle('ring-line', !active);
        });
      });
    });
    roomBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.vizRoomBtn ?? 0);
        rooms.forEach((room, i) => room.classList.toggle('hidden', i !== idx));
        roomBtns.forEach((b) => {
          const active = b === btn;
          b.setAttribute('aria-pressed', String(active));
          b.classList.toggle('bg-navy', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('bg-white', !active);
          b.classList.toggle('text-muted', !active);
        });
      });
    });
    intensity?.addEventListener('input', () => {
      if (tint) tint.style.opacity = String(Number(intensity.value) / 100);
    });
  });
</script>
