---
import { navLinks } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href.replace(/\/$/, '')));
---

<header id="site-header" class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur transition-shadow duration-300">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:h-[72px] sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2" aria-label="Painter — home">
      <span class="grid h-10 w-10 place-items-center rounded-full bg-sun text-navy">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
          <rect x="2" y="3" width="12" height="6" rx="2" fill="currentColor" stroke="none" />
          <path d="M14 6h2a2 2 0 0 1 2 2v2" />
          <rect x="16.5" y="11" width="3" height="9" rx="1.5" fill="currentColor" stroke="none" />
        </svg>
      </span>
      <span class="text-xl font-bold tracking-tight text-ink">Painter</span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class={`relative py-2 text-[15px] transition-colors ${isActive(link.href) ? 'font-semibold text-ink' : 'font-medium text-muted hover:text-ink'}`}
        >
          {link.label}
          {isActive(link.href) && <span class="absolute inset-x-0 -bottom-0.5 h-[3px] rounded-full bg-sun" aria-hidden="true"></span>}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact/" class="hidden items-center gap-2 rounded-full bg-sun px-5 py-2.5 text-sm font-semibold text-navy transition hover:bg-sun-deep sm:inline-flex">
        Request a Quote
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </a>
      <button
        id="menu-btn"
        class="grid h-11 w-11 place-items-center rounded-full border border-line text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="h-5 w-5" aria-hidden="true"><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" /></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-white lg:hidden">
    <nav class="mx-auto flex max-w-7xl flex-col px-4 py-3 sm:px-6" aria-label="Mobile">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class={`rounded-xl px-3 py-3 text-base ${isActive(link.href) ? 'bg-sun-soft font-semibold text-ink' : 'font-medium text-muted hover:bg-cream hover:text-ink'}`}
        >
          {link.label}
        </a>
      ))}
      <a href="/contact/" class="mt-3 inline-flex items-center justify-center gap-2 rounded-full bg-sun px-5 py-3 text-sm font-semibold text-navy sm:hidden">
        Request a Quote
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const setMenu = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
    btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  btn?.addEventListener('click', () => setMenu(menu?.classList.contains('hidden') ?? false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
</script>
