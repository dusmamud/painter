---
import Picture from './Picture.astro';
import Icon from './Icon.astro';

interface Props {
  name: string;
  role: string;
  avatar?: string;
  initials?: string;
  quote: string;
  class?: string;
}

const { name, role, avatar, initials, quote, class: cls } = Astro.props;
---

<figure class={`flex h-full flex-col rounded-3xl bg-white p-6 ring-1 ring-line ${cls ?? ''}`}>
  <div class="flex text-sun" role="img" aria-label="Rated 5 out of 5 stars">
    <Icon name="star" class="h-4 w-4" />
    <Icon name="star" class="h-4 w-4" />
    <Icon name="star" class="h-4 w-4" />
    <Icon name="star" class="h-4 w-4" />
    <Icon name="star" class="h-4 w-4" />
  </div>
  <blockquote class="mt-4 flex-1 text-[15px] leading-relaxed text-ink">&ldquo;{quote}&rdquo;</blockquote>
  <figcaption class="mt-5 flex items-center gap-3 border-t border-line pt-5">
    {avatar ? (
      <Picture src={avatar} alt="" sizes="44px" widths={[96, 160]} class="h-11 w-11 rounded-full object-cover" />
    ) : (
      <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-sun text-sm font-bold text-navy" aria-hidden="true">{initials ?? name.slice(0, 1)}</span>
    )}
    <span>
      <span class="block text-sm font-semibold text-ink">{name}</span>
      <span class="block text-xs text-muted">{role}</span>
    </span>
  </figcaption>
</figure>
